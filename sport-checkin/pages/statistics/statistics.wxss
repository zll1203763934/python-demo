.container {
  padding: 20rpx;
  box-sizing: border-box;
}

/* 周统计头部 */
.week-header {
  text-align: center;
  margin-bottom: 30rpx;
}

.week-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.week-date {
  font-size: 28rpx;
  color: #666;
}

/* 进度统计 */
.progress-section {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.progress-info {
  display: flex;
  align-items: baseline;
  margin-bottom: 20rpx;
}

.progress-score {
  font-size: 48rpx;
  font-weight: bold;
  color: #42b983;
}

.progress-target {
  font-size: 28rpx;
  color: #888;
  margin-left: 10rpx;
}

.progress-bar {
  margin-bottom: 20rpx;
}

/* 红包提示 */
.penalty-section {
  background-color: #fff8f8;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.penalty-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.penalty-amount {
  color: #ff6b6b;
  font-weight: bold;
  font-size: 32rpx;
}

.penalty-btn {
  background-color: #42b983;
  color: #fff;
  font-size: 28rpx;
  padding: 10rpx 40rpx;
  border-radius: 30rpx;
  margin-top: 10rpx;
}

.success-text {
  text-align: center;
  font-size: 28rpx;
  color: #42b983;
  margin-top: 20rpx;
}

/* 本周打卡记录 */
.records-section {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  border-left: 8rpx solid #42b983;
  padding-left: 20rpx;
}

.no-record {
  text-align: center;
  color: #999;
  padding: 30rpx 0;
}

.record-list {
  max-height: 600rpx;
  overflow-y: auto;
}

.record-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}

.record-date {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 10rpx;
}

.record-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.record-info {
  display: flex;
  flex-direction: column;
}

.record-type {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 5rpx;
}

.record-amount {
  font-size: 26rpx;
  color: #666;
}

.record-score {
  font-size: 30rpx;
  color: #42b983;
  font-weight: bold;
}

/* 特殊申请记录 */
.special-section {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.special-list {
  max-height: 400rpx;
  overflow-y: auto;
}

.special-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}

.special-date {
  font-size: 26rpx;
  color: #888;
  width: 180rpx;
}

.special-reason {
  flex: 1;
  font-size: 28rpx;
  margin: 0 20rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.special-status {
  font-size: 26rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.special-status.pending {
  background-color: #f8f8f8;
  color: #999;
}

.special-status.approved {
  background-color: #e6f7e6;
  color: #42b983;
}

.special-status.rejected {
  background-color: #fff0f0;
  color: #ff6b6b;
}

/* 规则说明 */
.rules-section {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.rules-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.rule-item {
  margin-bottom: 10rpx;
}