.container {
  padding: 20rpx;
  box-sizing: border-box;
}

/* 日期显示 */
.date-display {
  text-align: center;
  font-size: 32rpx;
  color: #666;
  padding: 20rpx 0;
  margin-bottom: 30rpx;
}

/* 已打卡显示 */
.checkin-done {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 40rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.done-icon {
  margin-bottom: 20rpx;
}

.done-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #3cc51f;
  margin-bottom: 30rpx;
}

.checkin-detail {
  width: 100%;
  margin-bottom: 30rpx;
}

.detail-item {
  display: flex;
  margin-bottom: 15rpx;
}

.detail-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #666;
}

.detail-value {
  flex: 1;
  font-size: 28rpx;
}

.highlight {
  color: #3cc51f;
  font-weight: bold;
}

.checkin-image {
  width: 100%;
  height: 400rpx;
  border-radius: 8rpx;
}

/* 打卡表单 */
.checkin-form {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.form-section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
}

/* 运动类型选择 */
.sport-types {
  display: flex;
  flex-wrap: wrap;
}

.sport-item {
  width: 22%;
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  margin-right: 3%;
  margin-bottom: 20rpx;
  font-size: 28rpx;
}

.sport-item:nth-child(4n) {
  margin-right: 0;
}

.sport-item.selected {
  background-color: #3cc51f;
  color: #fff;
}

/* 运动量输入 */
.input-group {
  display: flex;
  align-items: center;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 0 20rpx;
  height: 80rpx;
}

.amount-input {
  flex: 1;
  height: 80rpx;
  font-size: 30rpx;
}

.unit-label {
  font-size: 28rpx;
  color: #666;
  margin-left: 10rpx;
}

.score-preview {
  margin-top: 15rpx;
  font-size: 26rpx;
  color: #666;
}

.score-note {
  font-size: 24rpx;
  color: #999;
  margin-left: 10rpx;
}

/* 图片上传 */
.image-upload {
  width: 100%;
}

.upload-box {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #ddd;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.upload-icon {
  font-size: 60rpx;
  color: #ddd;
  margin-bottom: 10rpx;
}

.upload-text {
  font-size: 26rpx;
  color: #999;
}

.image-preview {
  position: relative;
  width: 100%;
  height: 400rpx;
}

.image-preview image {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}

.delete-btn {
  position: absolute;
  top: -20rpx;
  right: -20rpx;
  width: 60rpx;
  height: 60rpx;
  background-color: rgba(0, 0, 0, 0.5);
  color: #fff;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 40rpx;
}

/* 备注输入 */
.remark-input {
  width: 100%;
  height: 160rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 提交按钮 */
.submit-btn {
  background-color: #3cc51f;
  color: #fff;
  font-size: 32rpx;
  margin-top: 40rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
}

.submit-btn[disabled] {
  background-color: #9de69a;
  color: #fff;
}

/* 特殊申请 */
.special-request {
  text-align: center;
  margin-top: 30rpx;
  font-size: 28rpx;
  color: #3cc51f;
  text-decoration: underline;
}

/* 特殊申请弹窗 */
.special-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  border-radius: 20rpx 20rpx 0 0;
  padding: 40rpx 30rpx;
  transform: translateY(0);
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.modal-title {
  text-align: center;
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
}

.modal-form {
  margin-bottom: 40rpx;
}

.form-item {
  margin-bottom: 20rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 15rpx;
}

.special-reason {
  width: 100%;
  height: 160rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.picker-view {
  height: 80rpx;
  line-height: 80rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.modal-buttons {
  display: flex;
  justify-content: space-between;
}

.cancel-btn, .confirm-btn {
  width: 45%;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  font-size: 30rpx;
}

.cancel-btn {
  background-color: #f5f5f5;
  color: #666;
}

.confirm-btn {
  background-color: #3cc51f;
  color: #fff;
}